read_verilog -sv experiments/p2-zcu104-daq/rtl/axis_pattern_source.v experiments/p2-zcu104-daq/rtl/axis_sync_fifo.v experiments/p2-zcu104-daq/rtl/daq_stream_top.v experiments/p2-zcu104-daq/rtl/daq_axi_lite.v
