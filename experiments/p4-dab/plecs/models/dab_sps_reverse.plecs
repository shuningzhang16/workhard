      Axis { Name "v1 / V" AutoScale 1 MinValue -1 MaxValue 1 Signals {} SignalTypes [] AxisLabel "v1 / V" }
      Axis { Name "n*v2 / V" AutoScale 1 MinValue -1 MaxValue 1 Signals {} SignalTypes [] AxisLabel "n*v2 / V" }
      Axis { Name "iL / A" AutoScale 1 MinValue -1 MaxValue 1 Signals {} SignalTypes [] AxisLabel "iL / A" }

