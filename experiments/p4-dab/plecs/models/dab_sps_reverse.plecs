      Direction up
      Flipped off
      LabelPosition south
      Parameter { Variable "Ron" Value "0" Show off }
      Parameter { Variable "s_init" Value "0" Show off }
      Parameter { Variable "thermal" Value "" Show off }
      Parameter { Variable "Rth" Value "0" Show off }
      Parameter { Variable "Np" Value "1" Show off }
      Parameter { Variable "T_init" Value "25" Show off }

    }
    Connection { Type Wire SrcComponent "Vdc1" SrcTerminal 1
